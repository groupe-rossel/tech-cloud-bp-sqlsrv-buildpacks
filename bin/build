#!/usr/bin/env bash

BUILD_DIR=$1
CACHE_DIR=$2
PDO_LAYER="$LAYERS_DIR/pdo"

echo "---> Initialisation de Datadog Orchestrion Buildpack"

# 1. Déclarer la couche pour le cache (accélère drastiquement la CI)
cat > "$ORCH_LAYER.toml" <<EOF
[types]
build = true
cache = true
launch = true
EOF

echo "-----> Downloading and compiling custom extension from source"

# 1. Setup paths to point to the PHP environment provided by your buildpack
export PATH="$BUILD_DIR/.heroku/php/bin:$PATH"

# 2. Download the extension source code (adjust URL to your zip/tgz or git clone)
EXT_SRC="/tmp/custom-ext"
mkdir -p "$EXT_SRC"
curl -L https://github.com/microsoft/msphpsql/releases/download/v5.13.2/Linux_5.13.2RTW.tar.gz | tar -xz -C "$EXT_SRC" --strip-components=1

if ! command -v php-config &> /dev/null; then
    echo "ERROR: PHP configuration not found. Ensure the PHP buildpack runs before this one."
    exit 1
fi
EXT_DIR=$(php-config --extension-dir)

# 2. Copy the Microsoft .so files directly into the PHP extension directory
cp "$EXT_SRC/Linux/PDO_SQLSRV_8.5_NTS.so" "$EXT_DIR/php_pdo_sqlsrv.so"
cp "$EXT_SRC/Linux/SQLSRV_8.5_NTS.so" "$EXT_DIR/php_sqlsrv.so"


mkdir -p "$EXT_SRC/libodbc"
mkdir -p "$EXT_SRC/libodbcinst"
curl https://mirrors.edge.kernel.org/ubuntu/pool/main/u/unixodbc/libodbc2_2.3.9-5_amd64.deb -o "$EXT_SRC/libodbc/libodbc.deb"
curl https://mirrors.edge.kernel.org/ubuntu/pool/main/u/unixodbc/libodbcinst2_2.3.9-5ubuntu0.1_amd64.deb -o "$EXT_SRC/libodbcinst/libodbcinst.deb"

cd "$EXT_SRC/libodbc"
ar x libodbc.deb
tar --zstd -xvf data.tar.zst
cp "./usr/lib/x86_64-linux-gnu/libodbc.so.2.0.0" "$EXT_DIR/"
cp "./usr/lib/x86_64-linux-gnu/libodbc.so.2" "$EXT_DIR/"

cd "$EXT_SRC/libodbcinst"
ar x libodbcinst.deb
ls -latrh
tar --zstd -xvf data.tar.zst
cp "./usr/lib/x86_64-linux-gnu/libodbcinst.so.2.0.0" "$EXT_DIR/"
cp "./usr/lib/x86_64-linux-gnu/libodbcinst.so.2" "$EXT_DIR/"


# 3. Append the extension directives to the active php.ini file
# (Adjust the path to php.ini depending on your specific PHP buildpack configuration)
PHP_INI=$(php -i | awk -F'=> ' '/Loaded Configuration File/ {print $2}')

echo "extension=php_sqlsrv.so" >> "$PHP_INI"
echo "extension=php_pdo_sqlsrv.so" >> "$PHP_INI"

mkdir -p "$PDO_LAYER/env.launch"
# Append EXT_DIR to LD_LIBRARY_PATH for the BUILD phase
echo -n "$EXT_DIR" > "$PDO_LAYER/env.build/LD_LIBRARY_PATH.append"
echo -n ":" > "$PDO_LAYER/env.build/LD_LIBRARY_PATH.delim"

# Append EXT_DIR to LD_LIBRARY_PATH for the APP RUNTIME phase
echo -n "$EXT_DIR" > "$PDO_LAYER/env.launch/LD_LIBRARY_PATH.append"
echo -n ":" > "$PDO_LAYER/env.launch/LD_LIBRARY_PATH.delim"

echo "-----> Microsoft PHP Extensions successfully injected!"
