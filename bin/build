#!/usr/bin/env bash
set -euo pipefail

if [[ -f "composer.json" ]] && grep -Eq 'ext-sqlsrv|ext-pdo_sqlsrv|sqlsrv' "composer.json"; then

    LAYERS_DIR=$1

    # 1. Name your layer explicitly
    LAYER_NAME="pdo"
    PDO_LAYER="$LAYERS_DIR/$LAYER_NAME"

    echo "---> Initializing PDO SQLSRV Buildpack Layer"


    # Write the TOML file to $LAYERS_DIR/pdo.toml (NOT inside $PDO_LAYER)
    cat > "${PDO_LAYER}.toml" <<EOF
[types]
build = true
cache = true
launch = true
EOF

    echo "-----> Downloading and compiling custom extension from source"

    # 2. Setup PATH and PHP checks
    #export PATH="$BUILD_DIR/.heroku/php/bin:$PATH"

    if ! command -v php-config &> /dev/null; then
        echo "ERROR: PHP configuration not found. Ensure the PHP buildpack runs before this one."
        exit 1
    fi
    EXT_DIR=$(php-config --extension-dir)
    PHP_VERSION=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')
    PHP_EXT_SUFFIX="${PHP_VERSION}_NTS"

    # 3. Download MS SQL Extensions
    EXT_SRC="/tmp/custom-ext"
    mkdir -p "$EXT_SRC"
    curl -fsSL --retry 3 --retry-connrefused --connect-timeout 10 https://github.com/microsoft/msphpsql/releases/download/v5.13.2/Linux_5.13.2RTW.tar.gz | tar -xz -C "$EXT_SRC" --strip-components=1
    if [[ ! -f "$EXT_SRC/Linux/PDO_SQLSRV_${PHP_EXT_SUFFIX}.so" || ! -f "$EXT_SRC/Linux/SQLSRV_${PHP_EXT_SUFFIX}.so" ]]; then
        echo "ERROR: msphpsql 5.13.2 does not provide non-thread-safe extensions for PHP ${PHP_VERSION}."
        exit 1
    fi
    cp "$EXT_SRC/Linux/PDO_SQLSRV_${PHP_EXT_SUFFIX}.so" "$EXT_DIR/php_pdo_sqlsrv.so"
    cp "$EXT_SRC/Linux/SQLSRV_${PHP_EXT_SUFFIX}.so" "$EXT_DIR/php_sqlsrv.so"

    # 4. Download and extract unixODBC libs and the actual Microsoft ODBC Driver for SQL Server (msodbcsql18)
    mkdir -p "$EXT_SRC/libodbc" "$EXT_SRC/libodbcinst" "$EXT_SRC/msodbcsql"
    curl -fsSL --retry 3 --retry-connrefused --connect-timeout 10 https://mirrors.edge.kernel.org/ubuntu/pool/main/u/unixodbc/libodbc2_2.3.9-5_amd64.deb -o "$EXT_SRC/libodbc/libodbc.deb"
    curl -fsSL --retry 3 --retry-connrefused --connect-timeout 10 https://mirrors.edge.kernel.org/ubuntu/pool/main/u/unixodbc/libodbcinst2_2.3.9-5ubuntu0.1_amd64.deb -o "$EXT_SRC/libodbcinst/libodbcinst.deb"
    UBUNTU_RELEASE=$(grep VERSION_ID /etc/os-release | cut -d '"' -f 2)
    curl -fsSL --retry 3 --retry-connrefused --connect-timeout 10 "https://packages.microsoft.com/ubuntu/${UBUNTU_RELEASE}/prod/pool/main/m/msodbcsql18/msodbcsql18_18.6.2.1-1_amd64.deb" -o "$EXT_SRC/msodbcsql/msodbcsql18.deb"

    cd "$EXT_SRC/libodbc" && ar x libodbc.deb && tar --zstd -xf data.tar.zst
    cp ./usr/lib/x86_64-linux-gnu/libodbc.so* "$EXT_DIR/"

    cd "$EXT_SRC/libodbcinst" && ar x libodbcinst.deb && tar --zstd -xf data.tar.zst
    cp ./usr/lib/x86_64-linux-gnu/libodbcinst.so* "$EXT_DIR/"

    cd "$EXT_SRC/msodbcsql" && ar x msodbcsql18.deb && tar -xJf data.tar.xz
    # Copy the actual driver .so into EXT_DIR (already on LD_LIBRARY_PATH)
    cp ./opt/microsoft/msodbcsql18/lib64/libmsodbcsql-18*.so* "$EXT_DIR/"

    # Register it with unixODBC via a self-contained odbcinst.ini (no root/apt needed)
    ODBC_CONF_DIR="$PDO_LAYER/odbc"
    mkdir -p "$ODBC_CONF_DIR"
    DRIVER_SO_PATH=$(find "$EXT_DIR" -maxdepth 1 -type f -name 'libmsodbcsql-18*.so.*' -print -quit)
    if [[ -z "$DRIVER_SO_PATH" ]]; then
        echo "ERROR: Microsoft ODBC Driver library was not found after extraction."
        exit 1
    fi
    DRIVER_SO=$(basename "$DRIVER_SO_PATH")
    cat > "$ODBC_CONF_DIR/odbcinst.ini" <<EOF
[ODBC Driver 18 for SQL Server]
Description=Microsoft ODBC Driver 18 for SQL Server
Driver=$EXT_DIR/$DRIVER_SO
UsageCount=1
EOF

    # 5. Create CNB environment subdirectories properly
    mkdir -p "$PDO_LAYER/env.build"
    mkdir -p "$PDO_LAYER/env.launch"

    echo -n "$EXT_DIR" > "$PDO_LAYER/env.build/LD_LIBRARY_PATH.append"
    echo -n ":"       > "$PDO_LAYER/env.build/LD_LIBRARY_PATH.delim"

    echo -n "$EXT_DIR" > "$PDO_LAYER/env.launch/LD_LIBRARY_PATH.append"
    echo -n ":"       > "$PDO_LAYER/env.launch/LD_LIBRARY_PATH.delim"
    # unixODBC resolves ODBCINSTINI relative to ODBCSYSINI; an absolute ODBCINSTINI value is ignored by the driver manager.
    echo -n "$ODBC_CONF_DIR" > "$PDO_LAYER/env.build/ODBCSYSINI.override"
    echo -n "$ODBC_CONF_DIR" > "$PDO_LAYER/env.launch/ODBCSYSINI.override"
    echo -n "odbcinst.ini" > "$PDO_LAYER/env.build/ODBCINSTINI.override"
    echo -n "odbcinst.ini" > "$PDO_LAYER/env.launch/ODBCINSTINI.override"

    # Immediate shell export so local commands in this script work
    export LD_LIBRARY_PATH="$EXT_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export ODBCSYSINI="$ODBC_CONF_DIR"
    export ODBCINSTINI="odbcinst.ini"

    # 6. Enable PHP extensions in php.ini
    PHP_INI=$(php -i | awk -F'=> ' '/Loaded Configuration File/ {print $2}')

    sed -i '/libodbc/d' "$PHP_INI"
    sed -i '/php_sqlsrv.so/d' "$PHP_INI"
    sed -i '/php_pdo_sqlsrv.so/d' "$PHP_INI"

    echo "extension=php_sqlsrv.so" >> "$PHP_INI"
    echo "extension=php_pdo_sqlsrv.so" >> "$PHP_INI"

    echo "-----> Microsoft PHP Extensions successfully injected!"

    # Test
    php -m | grep sqlsrv

fi
