#!/usr/bin/env bash
set -e

if [[ -f "composer.json" ]] && grep -Eq 'ext-sqlsrv|ext-pdo_sqlsrv|sqlsrv' "composer.json"; then

    LAYERS_DIR=$1

    # 1. Name your layer explicitly
    LAYER_NAME="pdo"
    PDO_LAYER="$LAYERS_DIR/$LAYER_NAME"

    echo "---> Initializing PDO SQLSRV Buildpack Layer"


    # Write the TOML file to $LAYERS_DIR/pdo.toml (NOT inside $PDO_LAYER)
    cat > "${PDO_LAYER}.toml" <<EOF
[types]
build = true
cache = true
launch = true
EOF

    echo "-----> Downloading and compiling custom extension from source"

    # 2. Setup PATH and PHP checks
    #export PATH="$BUILD_DIR/.heroku/php/bin:$PATH"

    if ! command -v php-config &> /dev/null; then
        echo "ERROR: PHP configuration not found. Ensure the PHP buildpack runs before this one."
        exit 1
    fi
    EXT_DIR=$(php-config --extension-dir)

    # 3. Download MS SQL Extensions
    EXT_SRC="/tmp/custom-ext"
    mkdir -p "$EXT_SRC"
    curl -sL https://github.com/microsoft/msphpsql/releases/download/v5.13.2/Linux_5.13.2RTW.tar.gz | tar -xz -C "$EXT_SRC" --strip-components=1

    cp "$EXT_SRC/Linux/PDO_SQLSRV_8.5_NTS.so" "$EXT_DIR/php_pdo_sqlsrv.so"
    cp "$EXT_SRC/Linux/SQLSRV_8.5_NTS.so" "$EXT_DIR/php_sqlsrv.so"

    # 4. Download and extract unixODBC libs
    mkdir -p "$EXT_SRC/libodbc" "$EXT_SRC/libodbcinst"
    curl -sL https://mirrors.edge.kernel.org/ubuntu/pool/main/u/unixodbc/libodbc2_2.3.9-5_amd64.deb -o "$EXT_SRC/libodbc/libodbc.deb"
    curl -sL https://mirrors.edge.kernel.org/ubuntu/pool/main/u/unixodbc/libodbcinst2_2.3.9-5ubuntu0.1_amd64.deb -o "$EXT_SRC/libodbcinst/libodbcinst.deb"

    cd "$EXT_SRC/libodbc" && ar x libodbc.deb && tar --zstd -xf data.tar.zst
    cp ./usr/lib/x86_64-linux-gnu/libodbc.so* "$EXT_DIR/"

    cd "$EXT_SRC/libodbcinst" && ar x libodbcinst.deb && tar --zstd -xf data.tar.zst
    cp ./usr/lib/x86_64-linux-gnu/libodbcinst.so* "$EXT_DIR/"

    # 5. Create CNB environment subdirectories properly
    mkdir -p "$PDO_LAYER/env.build"
    mkdir -p "$PDO_LAYER/env.launch"

    echo -n "$EXT_DIR" > "$PDO_LAYER/env.build/LD_LIBRARY_PATH.append"
    echo -n ":"       > "$PDO_LAYER/env.build/LD_LIBRARY_PATH.delim"

    echo -n "$EXT_DIR" > "$PDO_LAYER/env.launch/LD_LIBRARY_PATH.append"
    echo -n ":"       > "$PDO_LAYER/env.launch/LD_LIBRARY_PATH.delim"

    # Immediate shell export so local commands in this script work
    export LD_LIBRARY_PATH="$EXT_DIR:$LD_LIBRARY_PATH"

    # 6. Enable PHP extensions in php.ini
    PHP_INI=$(php -i | awk -F'=> ' '/Loaded Configuration File/ {print $2}')

    sed -i '/libodbc/d' "$PHP_INI"
    sed -i '/php_sqlsrv.so/d' "$PHP_INI"
    sed -i '/php_pdo_sqlsrv.so/d' "$PHP_INI"

    echo "extension=php_sqlsrv.so" >> "$PHP_INI"
    echo "extension=php_pdo_sqlsrv.so" >> "$PHP_INI"

    echo "-----> Microsoft PHP Extensions successfully injected!"

    # Test
    php -m | grep sqlsrv

fi
